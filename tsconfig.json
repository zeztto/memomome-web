{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "types": [
      "node",
      "react",
      "react-dom"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/main.tsx",
    "tests/**/*.ts"
  ]
}
